{
  "name": "@repo/csbie",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist ../csbie-ui/dist",
    "dev": "bun --env-file=../../.env src/dev.ts",
    "build": "bun --filter @repo/csbie-ui build && bun build src/index.ts --target=bun --outdir=dist",
    "start": "bun --env-file=../../.env dist/index.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@repo/csbie-server": "workspace:*",
    "hono": "^4.8.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
