{
  "name": "@repo/mnie-app",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist ../mnie-ui/dist",
    "dev": "bun --env-file=../../.env src/dev.ts",
    "build": "bun --filter @repo/mnie-ui build && bun build src/index.ts --target=bun --outdir=dist --external @napi-rs/keyring",
    "start": "bun --env-file=../../.env dist/index.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@repo/mnie-server": "workspace:*",
    "hono": "^4.8.3"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
