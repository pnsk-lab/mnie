{
  "name": "@mnie/provider-mobile-suica",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pnsk-lab/mnie.git",
    "directory": "packages/provider-mobile-suica"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "cd ../.. && cd packages/provider-mobile-suica && vp pack",
    "dev": "vp pack --watch --no-clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@mnie/types": "workspace:*"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
