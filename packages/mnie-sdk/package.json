{
  "name": "@repo/mnie-sdk",
  "private": true,
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "cd ../.. && vp run @repo/mnie-types#build && cd packages/mnie-sdk && vp pack",
    "clean": "rm -rf dist",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@repo/mnie-types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
