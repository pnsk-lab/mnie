# Copy to .env for local development. Do not commit real values.

# Local development
PORT=8787
MNIE_SERVER_PORT=8787
MNIE_UI_DEV_PORT=5173
MNIE_DATABASE_PATH=./data/mnie-app.sqlite
MNIE_KEYRING_BACKEND=platform
MNIE_KEYRING_SQLITE_PATH=./data/mnie-app.keyring.sqlite
MNIE_KEYRING_SECRET=
MNIE_ORIGIN=http://127.0.0.1:5173
MNIE_CORS_ORIGIN=http://127.0.0.1:5173
MNIE_SESSION_COOKIE=mnie_session
MNIE_RP_NAME=MNIE
MNIE_RP_ID=127.0.0.1

# Initial owner passkey setup. Prefer the hash form outside throwaway local dev.
MNIE_SETUP_PASSWORD=
MNIE_SETUP_PASSWORD_HASH=

# SBI endpoints and local SBI session options. Values are loaded at runtime only.
SBI_AUTH_BASE_URL=
SBI_MTS_BASE_URL=
SBI_IZANAGI_BASE_URL=
SBI_MAIN_SITE_BASE_URL=
SMBC_DIRECT_BASE_URL=
SMBC_DIRECT_LOGIN_BASE_URL=
SBI_TRADE_PASSWORD=
SBI_DEVICE_ID=

# PayPay authenticated app session. PAYPAY_HEADERS_JSON is a JSON object of required
# device/integrity headers. Use createPayPayClient() for separate per-account values.
PAYPAY_BASE_URL=
PAYPAY_ACCOUNT_ID=default
PAYPAY_ACCESS_TOKEN=
PAYPAY_HEADERS_JSON={}
