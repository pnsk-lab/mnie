# Copy to .env for local development. Do not commit real values.

# Local development
PORT=8787
CSBIE_SERVER_PORT=8787
CSBIE_UI_DEV_PORT=5173
CSBIE_DATABASE_PATH=./data/csbie.sqlite
CSBIE_ORIGIN=http://127.0.0.1:5173
CSBIE_CORS_ORIGIN=http://127.0.0.1:5173
CSBIE_SESSION_COOKIE=csbie_session
CSBIE_RP_NAME=CSBIE
CSBIE_RP_ID=127.0.0.1

# Initial owner passkey setup. Prefer the hash form outside throwaway local dev.
CSBIE_SETUP_PASSWORD=
CSBIE_SETUP_PASSWORD_HASH=

# SBI endpoints and local SBI session options. Values are loaded at runtime only.
SBI_AUTH_BASE_URL=
SBI_MTS_BASE_URL=
SBI_IZANAGI_BASE_URL=
SBI_MAIN_SITE_BASE_URL=
SBI_TRADE_PASSWORD=
SBI_DEVICE_ID=
